{
  "entities": {
    "Call": {
      "title": "Call",
      "description": "Represents a raw signaling call document.",
      "type": "object",
      "properties": {
        "callerId": {
          "type": "string",
          "description": "Firebase Auth UID of the caller."
        },
        "callerName": {
          "type": "string",
          "description": "Name of the caller."
        },
        "callerEmail": {
          "type": "string",
          "description": "Email address of the caller."
        },
        "receiverEmail": {
          "type": "string",
          "description": "Email address of the receiver."
        },
        "meetUri": {
          "type": "string",
          "description": "Dynamically generated Google Meet space URI."
        },
        "status": {
          "type": "string",
          "enum": ["ringing", "answered", "missed", "ai_secretary_active", "ended"],
          "description": "Current signaling state of the call."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp of the call."
        }
      },
      "required": ["callerId", "callerName", "callerEmail", "receiverEmail", "meetUri", "status", "timestamp"]
    },
    "Voicemail": {
      "title": "Voicemail",
      "description": "Represents a recorded voicemail generated by the AI Secretary.",
      "type": "object",
      "properties": {
        "callerId": {
          "type": "string",
          "description": "Firebase Auth UID of the caller."
        },
        "callerName": {
          "type": "string",
          "description": "Name of the caller."
        },
        "callerEmail": {
          "type": "string",
          "description": "Email address of the caller status."
        },
        "receiverEmail": {
          "type": "string",
          "description": "Email address of the recipient."
        },
        "audioTranscript": {
          "type": "string",
          "description": "Transcript of the conversation with the AI Secretary."
        },
        "aiSummary": {
          "type": "string",
          "description": "AI-generated structured summary of the intent."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Time the voicemail was recorded."
        }
      },
      "required": ["callerId", "callerName", "callerEmail", "receiverEmail", "audioTranscript", "aiSummary", "timestamp"]
    }
  },
  "firestore": {
    "calls/{callId}": {
      "schema": "Call",
      "description": "Collection of real-time call states for signaling database."
    },
    "voicemails/{voicemailId}": {
      "schema": "Voicemail",
      "description": "Collection of recorded voicemails."
    }
  }
}
