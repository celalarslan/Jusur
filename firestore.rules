rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /calls/{callId} {
      // Allowed to retrieve or list if the logged-in user is involved
      allow read: if request.auth != null && (
        resource.data.callerEmail == request.auth.token.email ||
        resource.data.receiverEmail == request.auth.token.email
      );
      
      // Allowed to initiate call if the user is the caller
      allow create: if request.auth != null &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.callerEmail == request.auth.token.email;

      // Allowed to update status (answering, missing, activating secretary, ending)
      allow update: if request.auth != null && (
        resource.data.callerEmail == request.auth.token.email ||
        resource.data.receiverEmail == request.auth.token.email
      );

      // Either participant can clean up a finished call document.
      allow delete: if request.auth != null &&
        (
          resource.data.callerEmail == request.auth.token.email ||
          resource.data.receiverEmail == request.auth.token.email
        );
    }

    match /voicemails/{voicemailId} {
      // Receivers can read voicemails addressed to them; callers can read voicemail they left
      allow read: if request.auth != null && (
        resource.data.callerEmail == request.auth.token.email ||
        resource.data.receiverEmail == request.auth.token.email
      );

      // Caller or receiver can write a voicemail document
      allow create: if request.auth != null && (
        request.resource.data.callerId == request.auth.uid ||
        request.resource.data.callerEmail == request.auth.token.email
      );

      // Only the receiver can archive/delete voicemails
      allow update, delete: if request.auth != null && (
        resource.data.receiverEmail == request.auth.token.email
      );
    }

    match /notificationTokens/{tokenId} {
      allow read: if false;

      allow create, update: if request.auth != null &&
        request.resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.ownerEmail == request.auth.token.email;
    }

    match /publicUsers/{userEmail} {
      // Signed-in users can discover which contacts are already on Jusur.
      allow read: if request.auth != null;

      allow create, update: if request.auth != null &&
        userEmail == request.auth.token.email &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null &&
        userEmail == request.auth.token.email;
    }

    match /callLogs/{logId} {
      allow read: if request.auth != null && (
        resource.data.callerEmail == request.auth.token.email ||
        resource.data.receiverEmail == request.auth.token.email
      );

      allow create: if request.auth != null && (
        request.resource.data.callerEmail == request.auth.token.email ||
        request.resource.data.receiverEmail == request.auth.token.email
      );

      allow update, delete: if request.auth != null && (
        resource.data.callerEmail == request.auth.token.email ||
        resource.data.receiverEmail == request.auth.token.email
      );
    }

    match /secretaryProfiles/{profileEmail} {
      // Any signed-in caller may read a receiver's public secretary behavior.
      allow read: if request.auth != null;

      // Users can only maintain the secretary profile attached to their own email.
      allow create, update: if request.auth != null &&
        profileEmail == request.auth.token.email &&
        request.resource.data.ownerEmail == request.auth.token.email;

      allow delete: if request.auth != null &&
        profileEmail == request.auth.token.email;
    }
  }
}
